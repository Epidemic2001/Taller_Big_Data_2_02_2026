# Canales opcionales del bot de alertas (consumo 1).
# Copien este archivo como consumo/alertas/.env y completen solo los canales que quieran usar.
# El .env no se sube a git (está en .gitignore). Las variables ya definidas en el entorno tienen prioridad.

# Slack: webhook entrante del canal (Slack -> Apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Telegram: token que entrega @BotFather y el id del chat o grupo que recibe las alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo: por defecto va a Mailpit (docker compose --profile alertas up -d), bandeja en http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PUERTO=1025
# ALERTA_CORREO_DE=alertas@sismologia.local
# ALERTA_CORREO_A=equipo@sismologia.local
# Para un servidor SMTP real (usa STARTTLS si se define el usuario):
# SMTP_USUARIO=
# SMTP_CLAVE=
