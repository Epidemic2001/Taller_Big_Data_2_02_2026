    {
      "id": 5,
      "title": "Testimonios por macrozona",
      "type": "barchart",
      "description": "Dónde se sintió: macrozona de Chile aproximada por latitud",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-sismo"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-sismo"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT macrozona, count() AS testimonios FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc) GROUP BY macrozona ORDER BY testimonios DESC",
          "refId": "A"
