          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(quantile(0.5)(distancia_epicentro_km), 0) AS km FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc)",
