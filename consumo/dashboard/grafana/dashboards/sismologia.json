    {
      "id": 10,
      "title": "Sismos con más testimonios",
      "type": "table",
      "description": "Los sismos que más gente reportó, con su magnitud y alcance",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-sismo"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-sismo"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT unid AS sismo, any(region) AS region, any(magnitud) AS magnitud, any(profundidad_km) AS profundidad_km, count() AS testimonios, round(avg(intensidad_corregida), 1) AS intensidad_prom, round(max(intensidad_corregida), 1) AS intensidad_max, round(max(distancia_epicentro_km), 0) AS alcance_km FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc) GROUP BY unid ORDER BY testimonios DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "magnitud"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "testimonios"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E6FBF"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
