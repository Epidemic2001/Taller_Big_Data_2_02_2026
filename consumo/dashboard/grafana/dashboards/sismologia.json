    {
      "id": 7,
      "title": "Canal de reporte",
      "type": "piechart",
      "description": "Cómo reportó la gente: app, web móvil, web o teléfono",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-sismo"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-sismo"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf(canal = 'app', 'App móvil', canal = 'mob', 'Web móvil', canal = 'web', 'Web', canal = 'tel', 'Teléfono', canal) AS canal, count() AS testimonios FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc) GROUP BY canal ORDER BY testimonios DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
