            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-sismo"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfHour(tiempo_utc) AS time, count() AS testimonios FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc) GROUP BY time ORDER BY time",
          "refId": "A"
