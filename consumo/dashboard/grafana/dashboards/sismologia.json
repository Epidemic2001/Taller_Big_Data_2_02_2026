    {
      "id": 6,
      "title": "Atenuación: intensidad promedio según la distancia al epicentro",
      "type": "barchart",
      "description": "Mientras más lejos del epicentro, menos se siente: la atenuación de la intensidad",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-sismo"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-sismo"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(toString(toUInt16(intDiv(distancia_epicentro_km, 25) * 25)), '-', toString(toUInt16(intDiv(distancia_epicentro_km, 25) * 25 + 25)), ' km') AS distancia, round(avg(intensidad_corregida), 2) AS intensidad_promedio FROM sismologia.v_testimonios WHERE $__timeFilter(tiempo_utc) AND distancia_epicentro_km IS NOT NULL AND distancia_epicentro_km < 600 GROUP BY intDiv(distancia_epicentro_km, 25), distancia ORDER BY intDiv(distancia_epicentro_km, 25)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#C8402B"
          },
          "unit": "short",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "always",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "barWidth": 0.8,
        "groupWidth": 0.7
      }
    },
    {
